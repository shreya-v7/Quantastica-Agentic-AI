# ===========================================================
# Quantastica API -- Single Credential File
# ===========================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# This is the ONLY file you need to configure.
# No separate JSON key files required.
# ===========================================================

# --- Google Cloud / Firebase Service Account ---
# (All fields from your serviceAccountKey.json go here)
GCP_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GCP_PRIVATE_KEY_ID=your_private_key_id
GCP_CLIENT_ID=your_client_id

# --- Server ---
BASE_URL=http://localhost:8000
AGENT_MODE=in_process

# --- Alpaca Trading (Paper) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Twilio (WhatsApp Alerts -- optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TWILIO_TO_WHATSAPP=whatsapp:+918451920618

# --- NewsAPI (optional) ---
NEWSAPI_KEY=

# --- Test Data ---
# TEST_DATA_DIR=./test_data_dir

# --- Financial intelligence / contracts ---
# Must match packages/types/contracts.json (SSOT: packages/types/contracts.json)
CLOUD_PROVIDER=gcp
FI_FEATURE_AI=true
FI_FEATURE_INSIGHTS=true
FI_DEMO=true
FI_JWT_SECRET=change-me
FI_JWT_ALGORITHM=HS256
# FI_ENCRYPTION_KEY=   # optional Fernet key for encrypted snapshots
