# Quantastica server configuration. Copy to .env and fill in values.
# All config is read from the environment and validated at startup.

APP_ENV=dev
PLATFORM=local
LOG_LEVEL=INFO

# Core infrastructure (required on every platform)
DATABASE_URL=postgresql+asyncpg://quantastica:quantastica@localhost:5432/quantastica
REDIS_URL=redis://localhost:6379/0

# Auth (optional in dev, forced on in prod)
REQUIRE_AUTH=false
JWT_SECRET=
JWT_ALGORITHM=HS256

# CORS (comma separated). prod refuses the wildcard "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed endpoints (always on in dev, disabled in prod unless ALLOW_SEED=true)
ALLOW_SEED=false

# Trading: paper (default) or live. Live also needs Kite keys and prod gates.
TRADING_MODE=paper

# --- local platform (the only required secret locally is ANTHROPIC_API_KEY) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
STORAGE_DIR=./var/exports

# --- gcp platform (PLATFORM=gcp) ---
GCP_PROJECT=
GCP_REGION=us-central1
GCS_BUCKET=
VERTEX_MODEL=claude-3-5-haiku@20241022

# --- aws platform (PLATFORM=aws) ---
AWS_REGION=us-east-1
S3_BUCKET=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Optional S3-compatible storage on local (MinIO)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- providers (each is optional; /api/platform reports readiness honestly) ---
# Indian market news sentiment
NEWSAPI_KEY=
# RAG document embeddings
VOYAGE_API_KEY=
# Zerodha Kite Connect (live trading only)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# WhatsApp Meta Cloud API (dev uses a logged echo channel when unset)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Account Aggregator (Sahamati) gateway
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_BASE_URL=

# --- background worker (alerts + automation evaluation) ---
WORKER_POLL_SECONDS=15

# --- observability (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
